{
  "name": "stampy",
  "private": true,
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix stampy-backend run dev",
    "dev:web": "npm --prefix stampy-frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
